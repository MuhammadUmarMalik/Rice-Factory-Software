{
  "name": "mill-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop and web app for managing rice mill operations.",
  "license": "MIT",
  "author": {
    "name": "Muhammad Umar Malik",
    "url": "https://www.umarmalik-dev.com"
  },
  "scripts": {
    "dev": "npm run dev --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "start": "npm run start --prefix server",
    "check": "npm run check --prefix client 2>/dev/null || true && npm run check --prefix server 2>/dev/null || true",
    "db:push": "npm run db:push --prefix server",
    "db:seed": "tsx script/seed-admin.ts",
    "test": "tsx script/test-reports.ts",
    "electron:dev": "concurrently -k \"npm run dev --prefix server\" \"wait-on http://127.0.0.1:5000 && electron .\"",
    "electron:build": "node script/clean-desktop.js && tsx script/prepare-seed-db.ts && npm run build && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tsx": "^4.20.5",
    "wait-on": "^7.0.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.millmanager.app",
    "productName": "Mill Manager",
    "extraMetadata": {
      "homepage": "https://www.umarmalik-dev.com",
      "website": "https://www.ai-codinghub.com",
      "author": "Muhammad Umar Malik"
    },
    "win": {
      "publisherName": "Muhammad Umar Malik",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "terms-and-conditions.txt"
    },
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "node_modules/**",
      "client/public/app_icon.ico",
      "app-data/data.db"
    ],
    "asar": true,
    "icon": "client/public/app_icon.ico"
  }
}
