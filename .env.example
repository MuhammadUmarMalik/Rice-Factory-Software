# Mill Manager — environment variable reference.
# Copy to `.env` and fill in real values. Never commit the filled-in `.env`.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5177
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Database (SQLite)
# ---------------------------------------------------------------------------
# Directory holding the live data.db and settings.json. Defaults to `.local`.
APP_DATA_DIR=.local
# Overrides the derived path if you want the database somewhere else.
DATABASE_URL=file:./.local/data.db

# ---------------------------------------------------------------------------
# Auth / sessions — REQUIRED in production
# ---------------------------------------------------------------------------
# Long random strings. Generate with: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=

# ---------------------------------------------------------------------------
# Bootstrap admin (seeded on first run only)
# ---------------------------------------------------------------------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULLNAME=Administrator
DEFAULT_ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# HTTP security
# ---------------------------------------------------------------------------
# Redirect http -> https when serving over the network.
FORCE_HTTPS=false
# Absolute origin used for redirects and cookie scope, e.g. https://mill.example.com
CANONICAL_ORIGIN=
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Desktop (Electron) build
# ---------------------------------------------------------------------------
DESKTOP_BUILD=false
DISABLE_GPU=false
SERVER_WAIT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Error tracking (Sentry) — leave blank to disable
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_RELEASE=
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
# Stock level (in kg) below which a low-stock notification fires.
LOW_STOCK_THRESHOLD=100
